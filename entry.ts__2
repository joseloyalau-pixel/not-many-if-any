const db = globalThis.__B44_DB__ || { auth:{ isAuthenticated: async()=>false, me: async()=>null }, entities:new Proxy({}, { get:()=>({ filter:async()=>[], get:async()=>null, create:async()=>({}), update:async()=>({}), delete:async()=>({}) }) }), integrations:{ Core:{ UploadFile:async()=>({ file_url:'' }) } } };

import { createClientFromRequest } from 'npm:@base44/sdk@0.8.40';

const INVENTORY_SCHEMA = {
  type: "object",
  properties: {
    title: { type: "string" },
    brand: { type: "string" },
    category: { type: "string" },
    subcategory: { type: "string" },
    description: { type: "string" },
    condition_grade: { type: "string" },
    colour: { type: "string" },
    size: { type: "string" },
    material: { type: "string" },
    purchase_price: { type: "number" },
    estimated_value: { type: "number" },
    sale_price: { type: "number" },
    storage_location: { type: "string" },
    container: { type: "string" },
    status: { type: "string" },
    date_acquired: { type: "string" },
    date_listed: { type: "string" },
    notes: { type: "string" },
    sku: { type: "string" }
  },
  required: ["title"]
};

function genSku(category, seed) {
  const prefix = (category || "GEN").slice(0, 3).toUpperCase();
  const yy = String(new Date().getFullYear()).slice(-2);
  const num = String((seed % 9000) + 1000).padStart(4, "0");
  return `JL-${prefix}-${yy}${num}`;
}

export default async function(req) {
  try {
    const base44 = createClientFromRequest(req);

    const body = await req.json();
    const fileUrl = body.file_url;
    if (!fileUrl || typeof fileUrl !== "string") {
      return Response.json({ error: "file_url is required" }, { status: 400 });
    }

    const extraction = await db.asServiceRole.integrations.Core.ExtractDataFromUploadedFile({
      file_url: fileUrl,
      json_schema: INVENTORY_SCHEMA
    });

    if (!extraction || extraction.status !== "success" || !extraction.output) {
      return Response.json({ error: extraction?.details || "Could not read any rows from this file" }, { status: 422 });
    }

    const rows = Array.isArray(extraction.output) ? extraction.output : [extraction.output];
    if (!rows.length) {
      return Response.json({ error: "No rows found in file" }, { status: 422 });
    }

    const valid = rows.filter((r) => r && typeof r.title === "string" && r.title.trim());
    const skipped = rows.length - valid.length;

    const baseSeed = Date.now() % 1000;
    const prepared = valid.map((r, i) => {
      const data = { ...r };
      ["purchase_price", "estimated_value", "sale_price"].forEach((k) => {
        if (data[k] != null && data[k] !== "") data[k] = Number(data[k]);
      });
      if (!data.sku) data.sku = genSku(data.category, baseSeed + i);
      if (!data.inventory_id) data.inventory_id = `INV-${Date.now().toString().slice(-6)}${i}`;
      if (!data.barcode) data.barcode = data.sku;
      if (!data.status) data.status = "Unprocessed";
      if (data.is_one_of_one === undefined) data.is_one_of_one = true;
      return data;
    });

    const created = await db.asServiceRole.entities.Inventory.bulkCreate(prepared);
    return Response.json({
      imported: prepared.length,
      skipped,
      total: rows.length
    });
  } catch (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }
}