const db = globalThis.__B44_DB__ || { auth:{ isAuthenticated: async()=>false, me: async()=>null }, entities:new Proxy({}, { get:()=>({ filter:async()=>[], get:async()=>null, create:async()=>({}), update:async()=>({}), delete:async()=>({}) }) }), integrations:{ Core:{ UploadFile:async()=>({ file_url:'' }) } } };

import { createClientFromRequest } from 'npm:@base44/sdk@0.8.40';
import Stripe from 'npm:stripe@14.21.0';
import { secrets } from 'base44:runtime';

export default async function(req) {
  try {
    const body = await req.json().catch(() => ({}));
    const items = Array.isArray(body.items) ? body.items : [];
    if (!items.length) {
      return Response.json({ error: 'No items provided' }, { status: 400 });
    }

    const base44 = createClientFromRequest(req);
    const origin = body.origin || new URL(req.headers.get('origin') || req.headers.get('referer') || 'https://app.db.com').origin;
    const stripe = new Stripe(secrets.get('STRIPE_SECRET_KEY'));

    const lineItems = [];
    const inventoryIds = [];

    for (const it of items) {
      if (!it.id) return Response.json({ error: 'Missing item id' }, { status: 400 });
      const inv = await db.asServiceRole.entities.Inventory.get(it.id);
      if (!inv) return Response.json({ error: 'Item not found' }, { status: 404 });
      if (inv.status === 'Sold' || inv.status === 'Shipped') {
        return Response.json({ error: `${inv.title} is no longer available` }, { status: 409 });
      }
      const amount = Number(inv.sale_price);
      if (!amount || amount <= 0) {
        return Response.json({ error: `${inv.title} has no sale price` }, { status: 400 });
      }

      const photo = inv.photos?.[0];
      lineItems.push({
        price_data: {
          currency: 'aud',
          product_data: {
            name: inv.title,
            description: [inv.brand, inv.condition_grade].filter(Boolean).join(' · ') || undefined,
            images: photo && /^https?:\/\//.test(photo) ? [photo] : undefined,
            metadata: { inventory_id: inv.id, sku: inv.sku || '' },
          },
          unit_amount: Math.round(amount * 100),
        },
        quantity: 1,
      });
      inventoryIds.push(inv.id);
    }

    const session = await stripe.checkout.sessions.create({
      mode: 'payment',
      line_items: lineItems,
      success_url: `${origin}/checkout/success?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${origin}/shop`,
      metadata: {
        base44_app_id: Deno.env.get('BASE44_APP_ID'),
        inventory_ids: JSON.stringify(inventoryIds),
      },
    });

    return Response.json({ url: session.url, session_id: session.id });
  } catch (error) {
    console.error('createCheckoutSession error:', error.message);
    return Response.json({ error: error.message }, { status: 500 });
  }
}